# Jarvis ayarları - bu dosyayı .env olarak kopyalayıp doldurun
# Kullanım: setup scriptleri bu dosyayı otomatik okur, ya da elle:
#   export $(grep -v '^#' .env | xargs)   (Linux/Mac)

# --- Beyin seçimi ---
# ollama (ücretsiz/yerel) veya claude (Opus 4.8, ücretli)
JARVIS_PROVIDER=ollama

# --- Ollama (ücretsiz mod) ---
JARVIS_MODEL=llama3.1
OLLAMA_HOST=http://localhost:11434

# --- Claude (pro mod) ---
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_CLAUDE_MODEL=claude-opus-4-8        # ucuz seçenek: claude-haiku-4-5
# JARVIS_CLAUDE_MAX_TOKENS=2048

# --- Kod çalıştırma ---
# JARVIS_WORKSPACE=~/jarvis_workspace
# JARVIS_ALLOW_COMMANDS=1                     # kapatmak için 0

# --- E-posta (opsiyonel) ---
# Gmail için: uygulama şifresi oluşturun (normal şifre çalışmaz)
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=465
# JARVIS_SMTP_USER=mail@gmail.com
# JARVIS_SMTP_PASS=uygulama-sifresi
# JARVIS_SMTP_FROM=mail@gmail.com
# JARVIS_IMAP_HOST=imap.gmail.com

# --- Akıllı ev (Philips Hue, opsiyonel) ---
# JARVIS_HUE_BRIDGE=192.168.1.50
# JARVIS_HUE_KEY=hue-api-kullanici-anahtari
